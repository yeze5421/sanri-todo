{
  "name": "three-days",
  "version": "1.1.0",
  "private": true,
  "description": "A to-do list that lets go after 3 days. Six calming themes. Fully offline.",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "check": "node --check app.js && node --check appearance.js && node --check engine.js && node --check copy.js && node --check server.cjs && node --check desktop/main.cjs && node --check desktop/window.cjs && node --check desktop/assets.cjs",
    "web": "node server.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "pack:win": "electron-builder --win --x64 --dir --publish never"
  },
  "engines": {
    "node": ">=22.14"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "productName": "Three Days",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "build": {
    "appId": "local.threedays.todo",
    "productName": "Three Days",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "themes.css",
      "appearance.js",
      "app.js",
      "engine.js",
      "copy.js",
      "favicon.svg",
      "desktop/**/*.cjs",
      "build/icon.ico",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Three-Days-Windows-x64.exe"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "publish": null
  }
}
